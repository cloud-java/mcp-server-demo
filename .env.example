# yiketianqi 天气接口凭证
# 复制为 .env 并填写真实值（不要提交到 GitHub）

WEATHER_APPID="your_appid"
WEATHER_APPSECRET="your_appsecret"

# NewsAPI 凭证，见 https://newsapi.org/
NEWS_API_KEY="your_api_key"

# MCP 远程部署（可选）
# MCP_HOST=0.0.0.0
# MCP_PORT=8010
# 启用 DNS rebinding 防护时，必须把客户端实际访问的 Host 加入白名单（支持 * 通配端口）
# MCP_DNS_REBINDING_PROTECTION=true
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,47.115.228.162:*,your-domain.com:*

